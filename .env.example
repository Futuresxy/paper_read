# Local paper-ingestion configuration.
# Copy this file to .env and fill in the values. Never commit .env.

# Zhipu GLM OpenAI-compatible API. OPENAI_API_KEY is the compatibility
# variable expected by BlaBlaPaper; put your Zhipu open-platform API key here.
model_provider=ZhipuAI
model=glm-5.3
base_url=https://open.bigmodel.cn/api/paas/v4
wire_api=chat
OPENAI_API_KEY=REPLACE_WITH_GLM_API_KEY
MODEL_REASONING_EFFORT=high

# Figure understanding model. This value is REQUIRED by the current
# BlaBlaPaper implementation and the model must accept images.
model_image=glm-5v-turbo

# Required when the input is a PDF and MinerU must extract it.
MINERU_API_TOKEN=REPLACE_WITH_MINERU_TOKEN
MINERU_BASE_URL=https://mineru.net/api/v4

# Optional: configure a separate provider for figure understanding.
# IMAGE_API_KEY=
# image_base_url=
# image_wire_api=responses

# Optional: override the bundled BlaBlaPaper generator for local runs.
# BLABLAPAPER_DIR=/absolute/path/to/BlaBlaPaper
