# BlaBlaCutter local environment.
# LLM API config is read directly from this file.
model_provider=ZhipuAI
model=glm-5.3
model_image=glm-5v-turbo
base_url=https://open.bigmodel.cn/api/paas/v4
wire_api=chat
OPENAI_API_KEY=
MODEL_REASONING_EFFORT=high

# Required only when input is a PDF that must be parsed through MinerU.
MINERU_API_TOKEN=
MINERU_BASE_URL=https://mineru.net/api/v4

# The repository-level .env is sourced by scripts/run_paper_pipeline.sh.
